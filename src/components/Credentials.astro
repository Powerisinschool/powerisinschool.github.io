---
interface CredentialItem {
  title: string;
  issuer: string;
  date: string;
  href: string;
}

interface Props {
  items: CredentialItem[];
}

const { items } = Astro.props;
---

<div class="credentials-list">
  {items.map(item => (
    <div class="credential-row">
      <div class="credential-info">
        <h3 class="credential-title">{item.title}</h3>
        <p class="credential-meta">{item.issuer} &middot; {item.date}</p>
      </div>
      <a 
        href={item.href} 
        class="credential-link" 
        target="_blank" 
        rel="noopener noreferrer" 
        aria-label={`View ${item.title} certificate (opens in new tab)`}
      >
        View certificate &rarr;
      </a>
    </div>
  ))}
</div>

<style>
  .credentials-list {
    border-top: 1px solid var(--line-strong);
  }
  
  .credential-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    align-items: baseline;
    padding: 28px 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .credential-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 21px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: normal;
  }

  .credential-meta {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }

  .credential-link {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }
</style>
