---
import BaseLayout from "../layouts/Base.astro";

import Hero from "../components/Hero.astro";

import SectionHeading from "../components/SectionHeading.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects.js";

import Timeline from "../components/Timeline.astro";
import { timeline } from "../data/timeline";

import StackGrid from "../components/StackGrid.astro";
import { stack } from "../data/stack.js";

import Credentials from "../components/Credentials.astro";
import { credentials } from "../data/credentials.js";
---

<BaseLayout>
	<Hero />
  <section id="work" class="section section--raised">
    <div class="container">
      <SectionHeading
        eyebrow="01 / selected work"
        heading="Three projects, built from first principles."
      />
      <div class="projects-list">
        {projects.map(project => (
          <ProjectRow {...project} />
        ))}
      </div>
    </div>
  </section>
  <section id="about" class="section">
    <div class="container">
      <SectionHeading 
        eyebrow="02 / how I got here" 
        heading="From a target game in JUST BASIC to a kernel of my own." 
      />
      
      <Timeline items={timeline} />
    </div>
  </section>
  <section id="stack" class="section section--raised">
    <div class="container">
      <SectionHeading 
        eyebrow="03 / stack" 
        heading="What I work with."
      />

      <StackGrid stack={stack} />
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHeading 
        eyebrow="04 / credentials" 
        heading="Certified, for what it\u2019s worth."
      />

      <Credentials items={credentials} />
    </div>
  </section>
</BaseLayout>
